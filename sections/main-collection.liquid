<main class="container collection-main" id="CollectionMain">
  <header class="collection-header">
    <h1 class="collection-header__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="collection-header__desc">{{ collection.description }}</p>
    {%- endif -%}
    <p class="collection-header__count">{{ collection.products_count }} fragancias</p>
  </header>

  <div class="product-grid">
    {%- for product in collection.products -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}
  </div>
</main>

{% schema %}
{
  "name": "Pagina de coleccion"
}
{% endschema %}
