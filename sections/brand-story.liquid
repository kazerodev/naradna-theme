<section class="section brand-section">
  <div class="container">
    {%- if section.settings.image != blank -%}
      <img class="brand-section__image" src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.title | escape }}" loading="lazy" width="900" height="1125" data-aos="fade-right">
    {%- endif -%}
    <div class="brand-section__text-content" data-aos="fade-left" data-aos-delay="100">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-section__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="brand-section__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="brand-section__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.text2 != blank -%}
        <p class="brand-section__text">{{ section.settings.text2 }}</p>
      {%- endif -%}
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="btn btn--primary mt-24">{{ section.settings.btn_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Historia de marca",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "eyebrow", "label": "Texto eyebrow", "default": "Nuestra historia" },
    { "type": "text", "id": "title", "label": "Titulo", "default": "Naradna. Sin rodeos." },
    { "type": "textarea", "id": "text", "label": "Parrafo 1", "default": "No somos una marca de lujo. Somos algo mejor: una marca honesta." },
    { "type": "textarea", "id": "text2", "label": "Parrafo 2", "default": "19,99. Envio gratis. Sin excusas." },
    { "type": "text", "id": "btn_label", "label": "Boton texto", "default": "Descubrir coleccion" },
    { "type": "url", "id": "btn_url", "label": "Boton enlace" }
  ]
}
{% endschema %}
