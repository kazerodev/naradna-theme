<div class="legal-header">
  <div class="container">
    <nav class="legal-header__breadcrumb" aria-label="Migas de pan">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span> <span>{{ page.title }}</span>
    </nav>
    <h1 class="legal-header__title">{{ page.title }}</h1>
  </div>
</div>

<div class="container">
  <a class="legal-back" href="/">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    Volver
  </a>
  <div class="legal-body">
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pagina"
}
{% endschema %}
