<section class="trust-section">
  <div class="container">
    <div class="trust-grid trust-grid--3">
      <div class="trust-item" data-aos="fade-up" data-aos-delay="0">
        <svg class="trust-item__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        <div class="trust-item__title">{{ section.settings.badge1_title }}</div>
        <div class="trust-item__text">{{ section.settings.badge1_text }}</div>
      </div>
      <div class="trust-item" data-aos="fade-up" data-aos-delay="120">
        <svg class="trust-item__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <div class="trust-item__title">{{ section.settings.badge2_title }}</div>
        <div class="trust-item__text">{{ section.settings.badge2_text }}</div>
      </div>
      <div class="trust-item" data-aos="fade-up" data-aos-delay="240">
        <svg class="trust-item__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <div class="trust-item__title">{{ section.settings.badge3_title }}</div>
        <div class="trust-item__text">{{ section.settings.badge3_text }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Badges de confianza",
  "settings": [
    { "type": "text", "id": "badge1_title", "label": "Badge 1 titulo", "default": "Envio gratis" },
    { "type": "text", "id": "badge1_text", "label": "Badge 1 texto", "default": "En todos los pedidos, sin minimo" },
    { "type": "text", "id": "badge2_title", "label": "Badge 2 titulo", "default": "Pago seguro" },
    { "type": "text", "id": "badge2_text", "label": "Badge 2 texto", "default": "100% seguro y cifrado" },
    { "type": "text", "id": "badge3_title", "label": "Badge 3 titulo", "default": "Calidad garantizada" },
    { "type": "text", "id": "badge3_text", "label": "Badge 3 texto", "default": "Fragancias formuladas con ingredientes de calidad" }
  ]
}
{% endschema %}
