<section class="hero">
  {%- if section.settings.image != blank -%}
    <img class="hero__bg" src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.heading }}" loading="eager">
  {%- endif -%}
  <div class="container">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_url }}" class="btn btn--primary">{{ section.settings.btn_label }}</a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_url }}" class="btn btn--outline" style="border-color:rgba(255,255,255,0.6);color:#fff;">{{ section.settings.btn2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Nueva colección" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Fragancias que dejan huella." },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Siete fragancias crafteadas para quienes saben lo que quieren. Calidad real, precio justo." },
    { "type": "text", "id": "btn_label", "label": "Botón 1 texto", "default": "Descubrir colección" },
    { "type": "url", "id": "btn_url", "label": "Botón 1 enlace", "default": "/collections/all" },
    { "type": "text", "id": "btn2_label", "label": "Botón 2 texto", "default": "Para él" },
    { "type": "url", "id": "btn2_url", "label": "Botón 2 enlace", "default": "/collections/para-el" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
