{%- assign hero_image = section.settings.image -%}

<section class="hero{% if hero_image == blank %} hero--gradient{% endif %}" aria-label="{{ section.settings.heading | escape }}">
  {%- if hero_image != blank -%}
    <img
      class="hero__bg"
      src="{{ hero_image | image_url: width: 1800 }}"
      alt=""
      role="presentation"
      loading="eager"
      fetchpriority="high"
      width="1800" height="900">
  {%- endif -%}
  <div class="hero__overlay"></div>

  <!-- Floating particles -->
  <div class="hero__particles" aria-hidden="true">
    <span class="hero__particle" style="left:8%;bottom:15%;animation-duration:9s;animation-delay:0s;width:3px;height:3px"></span>
    <span class="hero__particle" style="left:22%;bottom:30%;animation-duration:13s;animation-delay:-4s"></span>
    <span class="hero__particle" style="left:38%;bottom:10%;animation-duration:11s;animation-delay:-2s;width:2px;height:2px"></span>
    <span class="hero__particle" style="left:55%;bottom:25%;animation-duration:8s;animation-delay:-6s;width:4px;height:4px"></span>
    <span class="hero__particle" style="left:68%;bottom:20%;animation-duration:15s;animation-delay:-1s"></span>
    <span class="hero__particle" style="left:80%;bottom:35%;animation-duration:10s;animation-delay:-3s;width:2px;height:2px"></span>
    <span class="hero__particle" style="left:91%;bottom:12%;animation-duration:12s;animation-delay:-7s"></span>
    <span class="hero__particle" style="left:14%;bottom:55%;animation-duration:14s;animation-delay:-5s;width:2px;height:2px"></span>
    <span class="hero__particle" style="left:45%;bottom:60%;animation-duration:16s;animation-delay:-9s;width:3px;height:3px"></span>
    <span class="hero__particle" style="left:75%;bottom:50%;animation-duration:11s;animation-delay:-8s;width:2px;height:2px"></span>
  </div>

  <div class="container">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="btn btn--primary">{{ section.settings.btn_label }}</a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_url | default: '/collections/para-ella' }}" class="btn btn--ghost">{{ section.settings.btn2_label }}</a>
        {%- endif -%}
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-num" data-count="7">0</span>
          <span class="hero__stat-label">Fragancias</span>
        </div>
        <div class="hero__stat-divider"></div>
        <div class="hero__stat">
          <span class="hero__stat-num">19,99€</span>
          <span class="hero__stat-label">Precio fijo</span>
        </div>
        <div class="hero__stat-divider"></div>
        <div class="hero__stat">
          <span class="hero__stat-num">&#10003;</span>
          <span class="hero__stat-label">Envio gratis</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true" onclick="window.scrollTo({top:window.innerHeight,behavior:'smooth'})">
    <span class="hero__scroll-line"></span>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo (opcional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Naradna Fragancias" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Fragancias que dejan huella." },
    { "type": "textarea", "id": "subheading", "label": "Subtitulo", "default": "Siete fragancias crafteadas para quienes saben lo que quieren. Calidad real, precio justo." },
    { "type": "text", "id": "btn_label", "label": "Boton 1 texto", "default": "Descubrir coleccion" },
    { "type": "url", "id": "btn_url", "label": "Boton 1 enlace" },
    { "type": "text", "id": "btn2_label", "label": "Boton 2 texto", "default": "Para ella" },
    { "type": "url", "id": "btn2_url", "label": "Boton 2 enlace" }
  ]
}
{% endschema %}
