{%- assign product = product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="product-page">
  <div class="container">

    <!-- GALERÍA -->
    <div class="product-gallery">
      <div class="product-gallery__main">
        <img
          id="MainProductImage"
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.featured_image.alt | escape }}"
          loading="eager"
          width="900" height="900">
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for image in product.images -%}
            <div class="product-gallery__thumb{% if forloop.first %} active{% endif %}">
              <img
                src="{{ image | image_url: width: 160 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="80" height="80">
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- INFO -->
    <div class="product-info">
      {%- assign gender_tag = '' -%}
      {%- if product.tags contains 'para-el' -%}{%- assign gender_tag = 'Para él' -%}
      {%- elsif product.tags contains 'para-ella' -%}{%- assign gender_tag = 'Para ella' -%}
      {%- elsif product.tags contains 'unisex' -%}{%- assign gender_tag = 'Unisex' -%}
      {%- endif -%}
      {%- if gender_tag != '' -%}
        <p class="product-info__category">{{ gender_tag }}</p>
      {%- endif -%}

      <h1 class="product-info__title">{{ product.title }}</h1>
      <p class="product-info__price">{{ current_variant.price | money }}</p>
      <p class="product-info__shipping">✓ Envío gratis incluido</p>

      <div class="product-info__urgency">
        ⚡ Quedan pocas unidades &mdash; pide el tuyo antes de que se agote
      </div>

      <div class="product-info__description">
        {{ product.description }}
      </div>

      <form class="product-form" action="/cart/add" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <div class="quantity-selector">
          <button type="button" class="qty-minus">&#8722;</button>
          <input type="number" name="quantity" value="1" min="1" max="99">
          <button type="button" class="qty-plus">&#43;</button>
        </div>
        <button type="submit" class="add-to-cart-btn">
          {%- if current_variant.available -%}
            Añadir al carrito
          {%- else -%}
            Agotado
          {%- endif -%}
        </button>
      </form>

      <!-- BADGES -->
      <div class="product-trust">
        <div class="product-trust-item">
          <svg width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          Envío gratis
        </div>
        <div class="product-trust-item">
          <svg width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Pago seguro
        </div>
        <div class="product-trust-item">
          <svg width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
          Devolución 30 días
        </div>
        <div class="product-trust-item">
          <svg width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          Calidad garantizada
        </div>
      </div>
    </div>

  </div>
</div>

<!-- PRODUCTOS RELACIONADOS -->
{%- assign related = product.collections.first.products -%}
{%- if related.size > 1 -%}
<section class="related-section">
  <div class="container">
    <div class="section__header">
      <p class="section__eyebrow">Colección</p>
      <h2 class="section__title">También te puede gustar</h2>
    </div>
    <div class="product-grid">
      {%- for p in related limit: 4 -%}
        {%- unless p.id == product.id -%}
          {%- render 'product-card', product: p -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Página de producto"
}
{% endschema %}
