{%- assign current_variant = product.selected_or_first_available_variant -%}

<article class="product-page" itemscope itemtype="https://schema.org/Product">
  <meta itemprop="name" content="{{ product.title | escape }}">
  <meta itemprop="description" content="{{ product.description | strip_html | escape }}">
  {%- if product.featured_image -%}
    <meta itemprop="image" content="{{ product.featured_image | image_url: width: 800 }}">
  {%- endif -%}

  <div class="container">

    <!-- GALERIA -->
    <div class="product-gallery" role="region" aria-label="Imagenes del producto">
      <div class="product-gallery__main">
        <img
          id="MainProductImage"
          src="{{ product.featured_image | image_url: width: 1000 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="eager"
          fetchpriority="high"
          width="1000" height="1000"
          itemprop="image">
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for image in product.images -%}
            <button class="product-gallery__thumb{% if forloop.first %} active{% endif %}" data-src="{{ image | image_url: width: 1000 }}" aria-label="Ver imagen {{ forloop.index }}">
              <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy" width="80" height="80">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- INFO -->
    <div class="product-info" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
      <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
      <meta itemprop="price" content="{{ current_variant.price | divided_by: 100.0 }}">
      <meta itemprop="availability" content="{% if current_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}">
      <link itemprop="url" href="{{ shop.url }}{{ product.url }}">

      {%- assign gender_tag = '' -%}
      {%- if product.tags contains 'para-el' -%}{%- assign gender_tag = 'Para el' -%}
      {%- elsif product.tags contains 'para-ella' -%}{%- assign gender_tag = 'Para ella' -%}
      {%- elsif product.tags contains 'unisex' -%}{%- assign gender_tag = 'Unisex' -%}
      {%- endif -%}

      <div class="product-info__breadcrumb">
        <a href="/">Inicio</a> <span aria-hidden="true">/</span>
        <a href="/collections/all">Fragancias</a> <span aria-hidden="true">/</span>
        <span>{{ product.title }}</span>
      </div>

      {%- if gender_tag != '' -%}
        <p class="product-info__category">{{ gender_tag }}</p>
      {%- endif -%}

      <h1 class="product-info__title" itemprop="name">{{ product.title }}</h1>

      <div class="product-info__price-row">
        <span class="product-info__price" itemprop="price">{{ current_variant.price | money }}</span>
        <span class="product-info__shipping-tag">&#10003; Envio gratis</span>
      </div>

      <div class="product-info__urgency" role="alert" aria-live="polite">
        <span class="urgency-dot"></span> Quedan pocas unidades &mdash; pide el tuyo antes
      </div>

      <div class="product-info__description" itemprop="description">
        {{ product.description }}
      </div>

      <form class="product-form" action="/cart/add" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        <div class="quantity-row">
          <label class="quantity-label">Cantidad</label>
          <div class="quantity-selector">
            <button type="button" class="qty-minus" aria-label="Menos">&#8722;</button>
            <input type="number" name="quantity" value="1" min="1" max="99" aria-label="Cantidad">
            <button type="button" class="qty-plus" aria-label="Mas">&#43;</button>
          </div>
        </div>

        {%- if current_variant.available -%}
          <button type="submit" class="add-to-cart-btn" name="add">
            Añadir al carrito &nbsp;&mdash;&nbsp; {{ current_variant.price | money }}
          </button>
        {%- else -%}
          <button type="button" class="add-to-cart-btn add-to-cart-btn--soldout" disabled>
            Agotado
          </button>
        {%- endif -%}
      </form>

      <!-- TRUST BADGES -->
      <div class="product-trust">
        <div class="product-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          <div><strong>Envio gratis</strong><br><small>En todos los pedidos</small></div>
        </div>
        <div class="product-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <div><strong>Pago seguro</strong><br><small>Visa, PayPal, Apple Pay</small></div>
        </div>
        <div class="product-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
          <div><strong>30 dias</strong><br><small>Devolucion sin preguntas</small></div>
        </div>
        <div class="product-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <div><strong>Calidad real</strong><br><small>Ingredientes de primera</small></div>
        </div>
      </div>

    </div>
  </div>
</article>

<!-- RELACIONADOS -->
{%- assign related = product.collections.first.products -%}
{%- if related.size > 1 -%}
<section class="related-section">
  <div class="container">
    <div class="section__header">
      <p class="section__eyebrow">Coleccion</p>
      <h2 class="section__title">También te puede gustar</h2>
    </div>
    <div class="product-grid">
      {%- for p in related limit: 4 -%}
        {%- unless p.id == product.id -%}
          {%- render 'product-card', product: p -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Pagina de producto"
}
{% endschema %}
