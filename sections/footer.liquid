<div class="footer__gold-line" aria-hidden="true"></div>
<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer__top">
      <div>
        <span class="footer__brand-name">{{ shop.name }}</span>
        <p class="footer__brand-desc">{{ section.settings.brand_desc }}</p>
        <div class="footer__social">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer__social-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              <span>Instagram</span>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="footer__social-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
              <span>TikTok</span>
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.email != blank -%}
          <a href="mailto:{{ section.settings.email }}" class="footer__email-link">{{ section.settings.email }}</a>
        {%- endif -%}
      </div>
      <div>
        <p class="footer__col-title">Colecciones</p>
        <ul class="footer__links">
          <li><a href="/collections/para-el">Para él</a></li>
          <li><a href="/collections/para-ella">Para ella</a></li>
          <li><a href="/collections/all">Todos los perfumes</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__col-title">Legal</p>
        <ul class="footer__links">
          <li><a href="/policies/privacy-policy">Política de privacidad</a></li>
          <li><a href="/policies/terms-of-service">Términos y condiciones</a></li>
          <li><a href="/policies/refund-policy">Política de devoluciones</a></li>
          <li><a href="/policies/shipping-policy">Política de envío</a></li>
          <li><a href="/pages/aviso-legal">Aviso legal</a></li>
          <li><a href="/pages/cookies">Política de cookies</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__col-title">Ayuda</p>
        <ul class="footer__links">
          <li><a href="/pages/contacto">Contacto</a></li>
          <li><a href="/pages/faq">Preguntas frecuentes</a></li>
          <li><a href="/collections/all">Ver todos los perfumes</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</p>
      <nav class="footer__legal-links" aria-label="Enlaces legales">
        <a href="/policies/privacy-policy">Privacidad</a>
        <a href="/policies/terms-of-service">Términos</a>
        <a href="/policies/refund-policy">Devoluciones</a>
        <a href="/pages/aviso-legal">Aviso legal</a>
        <a href="/pages/cookies">Cookies</a>
      </nav>
    </div>
    <div class="footer__payments-row">
      <div class="footer__payments" aria-label="Métodos de pago aceptados">
        <span class="footer__payment-badge">Visa</span>
        <span class="footer__payment-badge">Mastercard</span>
        <span class="footer__payment-badge">PayPal</span>
        <span class="footer__payment-badge">Apple Pay</span>
        <span class="footer__payment-badge">Google Pay</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de pagina",
  "settings": [
    { "type": "textarea", "id": "brand_desc", "label": "Descripcion de marca", "default": "Fragancias que no necesitan nombre prestado. Calidad real, precio justo." },
    { "type": "text", "id": "instagram", "label": "URL Instagram" },
    { "type": "text", "id": "tiktok", "label": "URL TikTok" },
    { "type": "text", "id": "email", "label": "Email de contacto", "default": "hola@naradna.com" }
  ]
}
{% endschema %}
