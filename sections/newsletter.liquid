<section class="section newsletter-section">
  <div class="container">
    <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section__title">{{ section.settings.title }}</h2>
    <p class="section__subtitle">{{ section.settings.subtitle }}</p>
    {% form 'customer' %}
      <div class="newsletter-form">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required>
        <button type="submit" name="commit">{{ section.settings.btn_label }}</button>
      </div>
    {% endform %}
    <p class="newsletter-note">{{ section.settings.note }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Comunidad Naradna" },
    { "type": "text", "id": "title", "label": "Titulo", "default": "Se el primero en saberlo." },
    { "type": "text", "id": "subtitle", "label": "Subtitulo", "default": "Nuevas fragancias, lanzamientos exclusivos y acceso anticipado." },
    { "type": "text", "id": "placeholder", "label": "Placeholder email", "default": "Tu email" },
    { "type": "text", "id": "btn_label", "label": "Boton", "default": "Apuntarme" },
    { "type": "text", "id": "note", "label": "Nota legal", "default": "Sin spam. Puedes darte de baja cuando quieras." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
