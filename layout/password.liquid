<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; background:#111; color:#fff; font-family:-apple-system,sans-serif; }
    .password-page { text-align:center; max-width:400px; padding:40px 20px; }
    .password-page h1 { font-size:32px; margin-bottom:16px; letter-spacing:3px; }
    .password-page p { color:rgba(255,255,255,0.6); margin-bottom:32px; }
    .password-page input { width:100%; padding:14px; border:1px solid rgba(255,255,255,0.2); background:rgba(255,255,255,0.05); color:#fff; font-size:15px; border-radius:3px; margin-bottom:12px; }
    .password-page button { width:100%; padding:14px; background:#c9a96e; color:#fff; border:none; font-size:13px; font-weight:700; letter-spacing:2px; text-transform:uppercase; cursor:pointer; border-radius:3px; }
  </style>
</head>
<body>
  <div class="password-page">
    <h1>{{ shop.name }}</h1>
    <p>Próximamente. Introduce la contraseña para acceder.</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Contraseña">
      <button type="submit">Entrar</button>
    {% endform %}
  </div>
</body>
</html>
